{
  // VS Code에서 F5로 실행/디버그할 구성들.
  // 실행 전에 반드시 인터프리터를 .venv로 선택할 것:
  //   Ctrl+Shift+P -> "Python: Select Interpreter" -> .venv\Scripts\python.exe
  "version": "0.2.0",
  "configurations": [
    {
      // 기본. F5 누르면 이게 뜬다. 브레이크포인트가 정상 동작하도록 --reload는 빼두었다.
      // (코드 저장 시 자동 재시작이 필요하면 아래 "백엔드 서버 (자동 리로드)" 사용)
      "name": "백엔드 서버 (디버그)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // 코드 저장하면 자동 재시작. 대신 리로더가 자식 프로세스를 띄우므로
      // 브레이크포인트는 잘 안 걸린다. 평상시 개발용.
      "name": "백엔드 서버 (자동 리로드)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // 하드웨어 없이 센서 데이터를 흘려보내는 시뮬레이터. (mosquitto 브로커 필요)
      "name": "센서 시뮬레이터",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/simulate_sensor.py",
      "args": [
        "--building", "bldg-a",
        "--floor", "f2",
        "--room", "room-101",
        "--device-id", "PY-NODE-101",
        "--host", "localhost",
        "--port", "1883"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      // 웹훅이 실제로 도착하는지 확인하는 수신자. .env의 WEBHOOK_SECRET과 값을 맞출 것.
      "name": "웹훅 수신자 (테스트)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/webhook_receiver.py",
      "args": ["--port", "9000", "--secret", "my-secret"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
