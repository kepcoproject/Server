# 이 파일을 복사해 .env 로 저장한 뒤 실제 값으로 채우세요.
# cp .env.example .env

# ---- MQTT 브로커 접속 정보 ----
# 브로커(mosquitto 등)가 없는 상태에서 API/대시보드만 개발한다면 false로 두세요.
# false면 연결 시도를 아예 하지 않아 "연결 실패, N초 후 재시도" 로그가 뜨지 않습니다.
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CLIENT_ID=smart-energy-backend
MQTT_KEEPALIVE=60

# ---- 재연결 지수 백오프 (초) ----
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=120

# ---- 토픽 prefix: v1/{building}/{floor}/{room_id}/{data|status} ----
MQTT_TOPIC_PREFIX=v1

# ---- 데이터베이스 ----
# 로컬 개발: SQLite (기본값)
DATABASE_URL=sqlite:///./smart_energy.db
# 운영/PostgreSQL 예시:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smart_energy

# ---- 아웃바운드 웹훅 ----
# 노드 온/오프라인 전환, 절전 알림을 외부 시스템(알림 서버, Slack/Discord 릴레이 등)에
# HTTP POST로 밀어주는 기능. 기본은 꺼져 있다.
WEBHOOK_ENABLED=false
# 콤마로 구분해 여러 개 등록 가능
WEBHOOK_URLS=
# 값을 넣으면 X-Webhook-Signature(HMAC-SHA256) 헤더가 붙는다. 수신자와 동일한 값을 공유할 것.
WEBHOOK_SECRET=
# "*" 이면 전체 전송. 예: device.offline,alert.energy_waste
WEBHOOK_EVENTS=*
WEBHOOK_TIMEOUT=5
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF=2

# ---- 절전 알림(alert.energy_waste) 임계값 ----
# 재실 false + power >= 임계값 이면 알림. 같은 공간은 cooldown 초 동안 재발행하지 않는다.
WEBHOOK_POWER_THRESHOLD=10.0
WEBHOOK_ALERT_COOLDOWN=300

# ---- 인증 ----
# 토큰 서명 키. 비우면 기동할 때마다 새로 만들어져 재시작 시 로그인이 풀린다.
# 배포할 때는 반드시 긴 임의 문자열을 넣을 것.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
AUTH_ACCESS_TTL_MINUTES=60
AUTH_REFRESH_TTL_DAYS=14

# 시연용 demo/demo1234 계정 자동 생성.
# 공개 배포에서는 반드시 false 로 두고 아래 부트스트랩 관리자를 쓸 것.
AUTH_DEMO_ACCOUNT=true

# 첫 관리자 계정 (없을 때만 만들어진다). 공개 배포 시 지정할 것.
AUTH_BOOTSTRAP_ADMIN_ID=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# ---- 메일 (회원가입 인증번호 · 비밀번호 찾기) ----
# 비워두면 메일을 보내지 않고 인증번호·링크를 서버 로그에 남긴다 (로컬 개발은 이걸로 충분).
# Gmail 은 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서
# 앱 비밀번호를 만들어 넣는다. 계정 비밀번호로는 로그인되지 않는다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 메일 속 링크(비밀번호 재설정)의 앞부분. 사용자가 브라우저로 여는 주소
PUBLIC_BASE_URL=

# ---- 프론트엔드 호환 레이어 ----
# 프론트가 기대하는 경로/응답 형식으로 같은 데이터를 다시 내보내는 계층.
COMPAT_API_ENABLED=true

# ---- 센서 노드 HTTP 수집 ----
# CT클램프가 재는 전류(A)를 전력(W)으로 바꿀 때 곱하는 전압.
SENSOR_LINE_VOLTAGE=220.0

# ---- 앱 공통 ----
APP_NAME=Smart Energy Saving System - Backend
LOG_LEVEL=INFO
# 프론트엔드 대시보드 도메인이 정해지면 콤마로 구분하여 제한할 것
CORS_ORIGINS=*
